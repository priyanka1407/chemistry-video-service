# Copy this file to .env and fill in real values. .env is gitignored -- never
# commit real API keys or connection strings with credentials in them.

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------
# Primary datastore. The `video_jobs` table is created automatically on
# startup if it does not already exist.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/postgres
# If Postgres is unreachable at startup, fall back to a local SQLite file
# instead of refusing to start. Set to false to make an unreachable Postgres
# a hard startup failure.
DB_ALLOW_SQLITE_FALLBACK=true
DB_FALLBACK_SQLITE_PATH=./jobs.db

# ---------------------------------------------------------------------------
# LLM provider (all text/embedding calls go through LangChain)
# ---------------------------------------------------------------------------
# google | openai | anthropic -- switching this is the ONLY change needed to
# move off Gemini; each provider needs its own API key below and its
# langchain-<provider> package installed (see requirements.txt).
LLM_PROVIDER=google

GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Exact model ids -- override to whatever you actually have access to.
EMBEDDING_MODEL=gemini-embedding-001
SCRIPT_MODEL=gemini-2.5-flash
# Optional secondary LLM guardrail pass for borderline similarity scores.
# Off by default: it costs a call per near-threshold request.
GUARDRAIL_USE_LLM=false
GUARDRAIL_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Video generation provider
# ---------------------------------------------------------------------------
# local -> Pillow slides + TTS + ffmpeg (default, ~$0.0005/video)
# veo   -> Google Veo short clips, called directly (LangChain has no video
#          support). Falls back to `local` on failure if FALLBACK_TO_LOCAL=true.
VIDEO_PROVIDER=local
FALLBACK_TO_LOCAL=true

VEO_MODEL=veo-3.1-fast-generate-preview
VEO_ASPECT_RATIO=16:9
VEO_DURATION_SECONDS=8
VEO_POLL_INTERVAL_SECONDS=10
VEO_TIMEOUT_SECONDS=600
# Veo clips are silent; overlay the same TTS narration used by the local
# provider so every video -- regardless of provider -- has audio, which QC
# requires.
VEO_ADD_TTS_AUDIO_OVERLAY=true

# ---------------------------------------------------------------------------
# Local renderer
# ---------------------------------------------------------------------------
# gtts (network, natural voice) | pyttsx3 (offline fallback) | silent (last resort)
TTS_PROVIDER=gtts
TTS_LANG=en
TTS_TLD=com
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=24
ARTIFACTS_DIR=./artifacts

# ---------------------------------------------------------------------------
# Reliability: retries before a fallback/failure kicks in
# ---------------------------------------------------------------------------
MAX_SCRIPT_ATTEMPTS=3
MAX_RENDER_ATTEMPTS=2

# ---------------------------------------------------------------------------
# Semantic gate
# ---------------------------------------------------------------------------
# Cosine similarity required to accept a query via the embedding path.
SEMANTIC_SIMILARITY_THRESHOLD=0.80
# Separate (stricter, different-scale) threshold for the offline lexical
# fallback used when embeddings are unavailable.
LEXICAL_SIMILARITY_THRESHOLD=0.35

# ---------------------------------------------------------------------------
# Guardrails
# ---------------------------------------------------------------------------
MIN_QUERY_LENGTH=3
MAX_QUERY_LENGTH=500
RATE_LIMIT_PER_MINUTE=30

# ---------------------------------------------------------------------------
# Cost model (USD) -- used for per-job cost attribution in API responses.
# Defaults are rough public list-price estimates; tune to your actual rates.
# ---------------------------------------------------------------------------
COST_EMBEDDING_PER_1K_TOKENS=0.00015
COST_SCRIPT_INPUT_PER_1M_TOKENS=0.30
COST_SCRIPT_OUTPUT_PER_1M_TOKENS=2.50
COST_VEO_PER_SECOND=0.15
COST_TTS_PER_1K_CHARS=0.0

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
WARMUP_ON_STARTUP=true
STRICT_STARTUP=false
LOG_LEVEL=INFO
