# Working artifact cache -- regenerated at startup, not part of the repo.
# The final 3 submission videos live in submission/videos/ instead, which
# IS tracked.
artifacts/*
!artifacts/.gitkeep

# Rotating log files (logs/api.log, logs/celery.log, ...) -- runtime output,
# not part of the repo.
logs/*
!logs/.gitkeep
