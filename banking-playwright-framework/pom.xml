<?xml version="1.0" encoding="UTF-8"?>
<!--
  Banking QA Automation Framework - Playwright for Java
  =====================================================

  CONSISTENT BROWSER VERSION (interview topic)
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  Every Playwright release is tested against ONE specific build of Chromium,
  Firefox and WebKit ("browser revisions"). The Java artifact version below
  therefore *is* the browser version pin:

      playwright 1.56.0  ->  chromium revision 1194 (Chromium 141.x)

  The same version string is used in:
    * this pom                          (<playwright.version>)
    * Dockerfile                        (mcr.microsoft.com/playwright/java:v1.56.0-noble)
    * .github/workflows + Jenkinsfile   (container image tag, browser cache key)
  so laptops, CI runners and the nightly grid all run byte-identical browsers.
  Never use version ranges / "LATEST" for Playwright - an unplanned browser bump
  is one of the most common causes of "it passed yesterday" flakiness.
  Renovate/Dependabot should bump the pom, image tag and cache key in ONE PR.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.bank.qa</groupId>
    <artifactId>banking-playwright-framework</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>Banking Playwright Framework</name>
    <description>Production-grade Playwright (Java) framework for authorization, payments and settlement testing</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Pinned - see header comment. -->
        <playwright.version>1.56.0</playwright.version>
        <junit.version>5.11.4</junit.version>
        <junit.platform.version>1.11.4</junit.platform.version>
        <jackson.version>2.18.2</jackson.version>
        <assertj.version>3.27.3</assertj.version>
        <json-schema-validator.version>1.5.6</json-schema-validator.version>
        <datafaker.version>2.4.2</datafaker.version>
        <slf4j.version>2.0.16</slf4j.version>

        <!--
          Test selection knobs (override on the command line / in CI):
            mvn test -Dgroups=smoke
            mvn test -DexcludedGroups=quarantine,slow
            mvn test -Denv=uat -Dbrowser=firefox -Dshard=2/4
        -->
        <groups />
        <excludedGroups>quarantine</excludedGroups>
        <!--
          FLAKINESS: Surefire re-runs a failed test up to N times. A test that
          fails then passes is reported as a *flake* (<flakyFailure> in the XML
          report) instead of silently green, so flakes stay visible and can be
          tracked/quarantined. 0 locally (fail fast), 2 in CI.
        -->
        <surefire.rerunFailingTestsCount>0</surefire.rerunFailingTestsCount>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- JSON Schema (draft 2020-12) validation for API contract checks and for validating our own mocks. -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${json-schema-validator.version}</version>
        </dependency>

        <!-- Seeded fake data (names, cities). Financial identifiers are generated by our own algorithms (Luhn / ISO 7064). -->
        <dependency>
            <groupId>net.datafaker</groupId>
            <artifactId>datafaker</artifactId>
            <version>${datafaker.version}</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Needed for the custom PostDiscoveryFilter that implements CI sharding. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>${junit.platform.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <groups>${groups}</groups>
                    <excludedGroups>${excludedGroups}</excludedGroups>
                    <rerunFailingTestsCount>${surefire.rerunFailingTestsCount}</rerunFailingTestsCount>
                    <!--
                      PARALLELISATION happens INSIDE one JVM via JUnit 5
                      (src/test/resources/junit-platform.properties).
                      forkCount=1 keeps a single JVM, so one embedded sample app and one
                      auth-state cache are shared. Cross-machine scale comes from CI
                      sharding (-Dshard=i/n), not from more forks.
                    -->
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                    <trimStackTrace>false</trimStackTrace>
                    <!-- Maven user properties (-Denv=uat -Dbrowser=firefox -Dshard=1/4 ...) are
                         forwarded to the test JVM by Surefire and read by FrameworkConfig. -->
                    <properties>
                        <configurationParameters>
                            junit.jupiter.extensions.autodetection.enabled = false
                        </configurationParameters>
                    </properties>
                </configuration>
            </plugin>

            <!-- mvn exec:java  -> starts the sample banking app on http://localhost:8085 for manual exploration / codegen. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>com.bank.qa.sampleapp.SampleBankServer</mainClass>
                    <classpathScope>compile</classpathScope>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn test -Pci : CI defaults (headless, retries on, quarantine excluded). -->
        <profile>
            <id>ci</id>
            <properties>
                <headless>true</headless>
                <surefire.rerunFailingTestsCount>2</surefire.rerunFailingTestsCount>
            </properties>
        </profile>
        <!-- mvn test -Pquarantine : run ONLY quarantined tests (nightly, non-blocking lane). -->
        <profile>
            <id>quarantine</id>
            <properties>
                <groups>quarantine</groups>
                <excludedGroups />
            </properties>
        </profile>
    </profiles>
</project>
